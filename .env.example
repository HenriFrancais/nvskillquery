# Bearer token the NV Tools reverse proxy sends with every request. Get the
# real value from Nero; anything is fine for local dev.
NV_TOKEN=dev-token-change-me

# Path prefix where the app is mounted behind the NV Tools proxy.
# Production: /skillquery. Leave empty for local dev at the root.
URL_PREFIX=

# Data source: "real" hits the upstream skills/users APIs below; "demo" loads
# the committed fixtures from DEMO_DATA_DIR.
DATA_SOURCE=real
DEMO_DATA_DIR=./data_demo

# Upstream APIs (see docs/upstream-api.md for the expected payloads).
SKILLS_API_URL=
SKILLS_API_TOKEN=
USERS_API_URL=
USERS_API_TOKEN=

# Snapshot refresh: stale-while-revalidate TTL in seconds (default 30 min).
SNAPSHOT_TTL_S=1800

# DEV_MODE=1 injects fake auth headers so local curls/browsers work without
# the NV Tools proxy. NOTE: the default dev identity (Member/Admin) does NOT
# pass the skill-query gate — set DEV_USER_RANK=CEO or DEV_USER_TEAMS=Doctrine.
DEV_MODE=0
DEV_USER_RANK=
DEV_USER_TEAMS=

LOG_LEVEL=INFO
